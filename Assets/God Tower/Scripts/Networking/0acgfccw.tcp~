using System;
using System.Collections.Concurrent;
using System.Net;
using System.Net.Sockets;
using System.Text;
using System.Threading;
using UnityEngine;

public class BumpWebhookServer : MonoBehaviour
{
    [Header("Server")]
    [SerializeField] private int port = 56789;

    [Header("References")]
    [SerializeField] private WebhookEventManager webhookEventManager;
    [SerializeField] private WebhookEventConfig[] webhookEvents;

    private TcpListener listener;
    private Thread listenerThread;
    private bool isRunning;

    private readonly ConcurrentQueue<Action> mainThreadActions =
        new ConcurrentQueue<Action>();

    #region UNITY FUNCTIONS

    private void Start()
    {
        StartServer();
    }

    private void Update()
    {
        while (mainThreadActions.TryDequeue(out Action action))
        {
            action?.Invoke();
        }
    }

    private void OnDisable()
    {
        StopServer();
    }

    private void OnApplicationQuit()
    {
        StopServer();
    }

    #endregion

    #region SERVER

    private void StartServer()
    {
        if (isRunning)
            return;

        try
        {
            listener =
                new TcpListener(
                    IPAddress.Any,
                    port
                );

            listener.Start();

            isRunning = true;

            listenerThread =
                new Thread(ListenLoop);

            listenerThread.IsBackground = true;
            listenerThread.Start();

            Debug.Log(
                $"Webhook server listening on port {port}"
            );
        }
        catch (Exception exception)
        {
            Debug.LogError(
                $"Failed to start webhook server: " +
                $"{exception.Message}"
            );
        }
    }

    private void ListenLoop()
    {
        while (isRunning)
        {
            try
            {
                TcpClient client =
                    listener.AcceptTcpClient();

                HandleClient(client);
            }
            catch (SocketException)
            {
                if (isRunning)
                {
                    Debug.LogError(
                        "Webhook server socket error."
                    );
                }
            }
            catch (Exception exception)
            {
                if (isRunning)
                {
                    Debug.LogError(
                        $"Webhook error: " +
                        $"{exception.Message}"
                    );
                }
            }
        }
    }

    private void HandleClient(TcpClient client)
    {
        using (client)
        using (NetworkStream stream = client.GetStream())
        {
            byte[] buffer =
                new byte[4096];

            int bytesRead =
                stream.Read(
                    buffer,
                    0,
                    buffer.Length
                );

            if (bytesRead <= 0)
                return;

            string request =
                Encoding.UTF8.GetString(
                    buffer,
                    0,
                    bytesRead
                );

            ProcessRequest(
                request,
                stream
            );
        }
    }

    #endregion

    #region REQUEST PROCESSING

    private void ProcessRequest(
        string request,
        NetworkStream stream)
    {
        string[] lines =
            request.Split(
                new[] { "\r\n" },
                StringSplitOptions.None
            );

        if (lines.Length == 0)
        {
            SendResponse(
                stream,
                400,
                "Bad Request"
            );

            return;
        }

        string[] requestLine =
            lines[0].Split(' ');

        if (requestLine.Length < 2)
        {
            SendResponse(
                stream,
                400,
                "Bad Request"
            );

            return;
        }

        string method =
            requestLine[0]
                .ToUpperInvariant();

        string path =
            NormalizePath(
                requestLine[1]
            );

        // -------------------------
        // VALIDATE METHOD
        // -------------------------

        bool validMethod =
            method == "GET" ||
            method == "POST";

        if (!validMethod)
        {
            SendResponse(
                stream,
                405,
                "Method Not Allowed"
            );

            return;
        }

        // -------------------------
        // FIND EVENT
        // -------------------------

        WebhookEventConfig webhookEvent =
            FindEvent(path);

        if (webhookEvent == null)
        {
            SendResponse(
                stream,
                404,
                $"Unknown webhook route: {path}"
            );

            return;
        }

        // -------------------------
        // TRIGGER EVENT
        // -------------------------

        Debug.Log(
            $"Webhook received: " +
            $"{method} {path} -> " +
            $"{webhookEvent.EventName}"
        );

        mainThreadActions.Enqueue(
            () => TriggerEvent(webhookEvent)
        );

        // -------------------------
        // RESPONSE
        // -------------------------

        SendResponse(
            stream,
            200,
            $"{webhookEvent.EventName} received"
        );
    }

    private string NormalizePath(
        string path)
    {
        if (string.IsNullOrEmpty(path))
            return "/";

        // Remove query parameters.
        int queryIndex =
            path.IndexOf('?');

        if (queryIndex >= 0)
        {
            path =
                path.Substring(
                    0,
                    queryIndex
                );
        }

        // Treat /car/ as /car.
        if (path.Length > 1)
        {
            path =
                path.TrimEnd('/');
        }

        return path;
    }

    private WebhookEventConfig FindEvent(
        string route)
    {
        if (webhookEvents == null)
            return null;

        foreach (
            WebhookEventConfig webhookEvent
            in webhookEvents)
        {
            if (webhookEvent == null)
                continue;

            if (string.Equals(
                webhookEvent.Route,
                route,
                StringComparison.OrdinalIgnoreCase))
            {
                return webhookEvent;
            }
        }

        return null;
    }

    private void TriggerEvent(
        WebhookEventConfig config)
    {
        if (webhookEventManager == null)
        {
            Debug.LogWarning(
                "Webhook received, but no " +
                "WebhookEventManager is assigned."
            );

            return;
        }

        webhookEventManager.TriggerEvent(
            config
        );
    }

    #endregion

    #region RESPONSE

    private void SendResponse(
        NetworkStream stream,
        int statusCode,
        string message)
    {
        string statusText =
            statusCode switch
            {
                200 => "OK",
                400 => "Bad Request",
                404 => "Not Found",
                405 => "Method Not Allowed",
                _ => "Error"
            };

        string body =
            message ?? string.Empty;

        string response =
            $"HTTP/1.1 {statusCode} {statusText}\r\n" +
            "Content-Type: text/plain; charset=utf-8\r\n" +
            $"Content-Length: {Encoding.UTF8.GetByteCount(body)}\r\n" +
            "Connection: close\r\n" +
            "\r\n" +
            body;

        byte[] responseBytes =
            Encoding.UTF8.GetBytes(
                response
            );

        stream.Write(
            responseBytes,
            0,
            responseBytes.Length
        );
    }

    #endregion

    #region CLEANUP

    private void StopServer()
    {
        if (!isRunning &&
            listener == null)
        {
            return;
        }

        isRunning = false;

        try
        {
            listener?.Stop();
        }
        catch (Exception exception)
        {
            Debug.LogWarning(
                $"Error stopping webhook server: " +
                $"{exception.Message}"
            );
        }

        if (listenerThread != null &&
            listenerThread.IsAlive)
        {
            listenerThread.Join(500);
        }

        listener = null;
        listenerThread = null;

        Debug.Log(
            "Webhook server stopped."
        );
    }

    #endregion
}